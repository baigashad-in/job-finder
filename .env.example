# Copy to .env and run: npm run start:env   (needs Node 20.6 or newer)
# Or export these in your shell and run: npm start

# Required. Create one at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Server
PORT=3000
HOST=127.0.0.1
# Re-run every saved search this often, in hours. 0 turns it off.
REFRESH_HOURS=0
DATA_DIR=./data

# Limits
# Most job boards read per search (Fetch, free)
MAX_BOARDS=25
# Most posting pages read per search to check visa notes and dates (Fetch, free)
ENRICH_LIMIT=20

# Agent (uses credits)
# Ceiling on Agent runs per search for everyone using this server. Set 0 or 1 on a public deploy.
AGENT_RUNS_LIMIT=6
AGENT_CACHE_HOURS=12
AGENT_MAX_WAIT_SECONDS=200
# 1 = retry once in stealth mode if a site blocks the browser, 0 = never
AGENT_STEALTH_RETRY=1
